    "import pandas as pd\n",
    "import numpy as np\n",
    "import os\n",
    "\n",
    "# Setup\n",
    "raw_data_path = 'data/00-raw/stadiums.csv'\n",
    "processed_data_path = 'data/02-processed/processed_data.csv'\n",
    "\n",
    "os.makedirs('data/02-processed', exist_ok=True)\n",
    "\n",
    "try:\n",
    "    df_raw_stadiums = pd.read_csv(raw_data_path, low_memory=False)\n",
    "except FileNotFoundError:\n",
    "    print('Files not found. Please ensure they are in data/00-raw/')\n",
    "    df_raw_stadiums = pd.DataFrame()\n",
    "\n",
    "# Tidy Structure\n",
    "print('First 5 Rows:')\n",
    "print(df_raw_stadiums.head())\n",
    "print('Column Names:')\n",
    "print(df_raw_stadiums.columns.tolist())\n",
    "print('Each row represents one professional sports team and each column represents a variable, such as league and coordinates.')\n",
    "print('Dataset is already tidy.')\n",
    "\n",
    "# Shape\n",
    "print('Dataset Shape (rows, columns):', df_raw_stadiums.shape)\n",
    "\n",
    "# Missing Values\n",
    "missing_vals = df_raw_stadiums.isna().sum()\n",
    "print('Missing Values Per Column:')\n",
    "print(missing_vals)\n",
    "print('Missingness Correlation Matrix:')\n",
    "print(df_raw_stadiums.isna().astype(int).corr())\n",
    "\n",
    "# Location Outliers\n",
    "numeric_cols = ['Lat', 'Long']\n",
    "for col in numeric_cols:\n",
    "    Q1 = df_raw_stadiums[col].quantile(0.25)\n",
    "    Q3 = df_raw_stadiums[col].quantile(0.75)\n",
    "    IQR = Q3 - Q1\n",
    "    lower = Q1 - 1.5 * IQR\n",
    "    upper = Q3 + 1.5 * IQR\n",
    "    outliers = df_raw_stadiums[(df_raw_stadiums[col] < lower) | (df_raw_stadiums[col] > upper)]\n",
    "    print(f'Outliers in {col}: {len(outliers)}')\n",
    "# outliers in {col}: {len(outliers)}')\n",
    "\n",
    "# Data Cleaning\n",
    "df_clean_stadiums = df_raw_stadiums.dropna(subset=['Lat', 'Long'])\n",
    "\n",
    "# Remove Canadian teams (falling outside US Census ZCTA boundaries)\n",
    "canadian_teams = [\n",
    "    'Toronto Raptors', 'Montreal Canadiens', 'Winnipeg Jets', \n",
    "    'Ottawa Senators', 'Vancouver Canucks', 'Edmonton Oilers', \n",
    "    'Toronto Maple Leafs', 'Calgary Flames', 'Toronto Blue Jays', \n",
    "    'Vancouver Whitecaps FC', 'Toronto FC', 'CF Montréal'\n",
    "]\n",
    "df_clean_stadiums = df_clean_stadiums[~df_clean_stadiums['Team'].isin(canadian_teams)]\n",
    "\n",
    "print('Final Dataset Shape After Cleaning:', df_clean_stadiums.shape)\n",
    "\n",
    "# Save Processed Data\n",
    "df_clean_stadiums.to_csv(processed_data_path, index=False)\n",
    "print('Processed dataset saved to data/02-processed/')"
   ]
