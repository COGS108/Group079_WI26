    "## YOUR CODE HERE\n",
    "## FEEL FREE TO ADD MULTIPLE CELLS PER SECTION\n",
    "import pandas as pd\n",
    "import numpy as np\n",
    "import seaborn as sns\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "def _first_series(df, colname):\n",
    "    selected = df.loc[:, colname]\n",
    "    if isinstance(selected, pd.DataFrame):\n",
    "        return selected.iloc[:, 0]\n",
    "    return selected\n",
    "\n",
    "def _to_num(series):\n",
    "    return pd.to_numeric(\n",
    "        series.astype(str)\n",
    "        .str.replace(',', '', regex=False)\n",
    "        .str.replace('$', '', regex=False)\n",
    "        .str.replace('(X)', '', regex=False)\n",
    "        .str.replace('nan', '', regex=False),\n",
    "        errors='coerce'\n",
    "    )\n",
    "\n",
    "# Try direct median household income column -----\n",
    "income_candidates = [\n",
    "    c for c in df_income.columns\n",
    "    if ('Median household income (dollars)' in c) and ('Margin' not in c)\n",
    "]\n",
    "\n",
    "direct_income_df = pd.DataFrame()\n",
    "if income_candidates:\n",
    "    chosen_col = income_candidates[0]\n",
    "    direct_income_df = pd.DataFrame({\n",
    "        'zip_code': _first_series(df_income, 'Geography').astype(str).str.extract(r'(\\d{5})', expand=False).str.zfill(5),\n",
    "        'median_household_income': _to_num(_first_series(df_income, chosen_col))\n",
    "    }).dropna(subset=['zip_code', 'median_household_income'])\n",
    "\n",
    "# Fallback: estimate median from income-bin percentages \n",
    "if direct_income_df.empty:\n",
    "    bin_specs = [\n",
    "        ('Less than $10,000', 0, 10000),\n",
    "        ('$10,000 to $14,999', 10000, 15000),\n",
    "        ('$15,000 to $24,999', 15000, 25000),\n",
    "        ('$25,000 to $34,999', 25000, 35000),\n",
    "        ('$35,000 to $49,999', 35000, 50000),\n",
    "        ('$50,000 to $74,999', 50000, 75000),\n",
    "        ('$75,000 to $99,999', 75000, 100000),\n",
    "        ('$100,000 to $149,999', 100000, 150000),\n",
    "        ('$150,000 to $199,999', 150000, 200000),\n",
    "        ('$200,000 or more', 200000, 250000),\n",
    "    ]\n",
    "\n",
    "    bin_cols = []\n",
    "    for label, _, _ in bin_specs:\n",
    "        matches = [\n",
    "            c for c in df_income.columns\n",
    "            if ('Total households!!' + label in c) and ('Margin' not in c)\n",
    "        ]\n",
    "        if matches:\n",
    "            bin_cols.append(matches[0])\n",
    "        else:\n",
    "            bin_cols.append(None)\n",
    "\n",
    "    if any(c is None for c in bin_cols):\n",
    "        missing_labels = [bin_specs[i][0] for i, c in enumerate(bin_cols) if c is None]\n",
    "        raise ValueError(f'Missing required income-bin columns for fallback estimate: {missing_labels}')\n",
    "\n",
    "    pct_matrix = pd.concat([_to_num(_first_series(df_income, c)).rename(c) for c in bin_cols], axis=1).fillna(0.0)\n",
    "\n",
    "    def _estimate_median_from_bins(row_vals):\n",
    "        percentages = np.array(row_vals, dtype=float)\n",
    "        total = np.nansum(percentages)\n",
    "        if total <= 0:\n",
    "            return np.nan\n",
    "        percentages = percentages * (100.0 / total)\n",
    "        cumulative = 0.0\n",
    "        for pct, (_, lower, upper) in zip(percentages, bin_specs):\n",
    "            next_cum = cumulative + pct\n",
    "            if next_cum >= 50:\n",
    "                if pct <= 0:\n",
    "                    return float(lower)\n",
    "                frac = (50 - cumulative) / pct\n",
    "                return float(lower + frac * (upper - lower))\n",
    "            cumulative = next_cum\n",
    "        return float(bin_specs[-1][2])\n",
    "\n",
    "    estimated_income = pct_matrix.apply(_estimate_median_from_bins, axis=1)\n",
    "\n",
    "    direct_income_df = pd.DataFrame({\n",
    "        'zip_code': _first_series(df_income, 'Geography').astype(str).str.extract(r'(\\d{5})', expand=False).str.zfill(5),\n",
    "        'median_household_income': estimated_income\n",
    "    }).dropna(subset=['zip_code', 'median_household_income'])\n",
    "\n",
    "    # Used fallback estimate from household income bins because direct median income column had no numeric values.\n",
    "\n",
    "#  Merge with treatment/control groups and plot\n",
    "groups_for_plot = combined_groups.copy()\n",
    "groups_for_plot['zip_code'] = groups_for_plot['zip_code'].astype(str).str.zfill(5)\n",
    "\n",
    "income_violin_df = direct_income_df.merge(\n",
    "    groups_for_plot[['zip_code', 'Group']],\n",
    "    on='zip_code',\n",
    "    how='inner'\n",
    " )\n",
    "\n",
    "\n",
    "if income_violin_df.empty:\n",
    "    print('No overlapping rows found for violin plot.')\n",
    "else:\n",
    "    plt.figure(figsize=(10, 6))\n",
    "    sns.violinplot(\n",
    "        data=income_violin_df,\n",
    "        x='Group',\n",
    "        y='median_household_income',\n",
    "        inner='quartile',\n",
    "        cut=0\n",
    "    )\n",
    "    sns.stripplot(\n",
    "        data=income_violin_df.sample(min(800, len(income_violin_df)), random_state=42),\n",
    "        x='Group',\n",
    "        y='median_household_income',\n",
    "        color='black',\n",
    "        alpha=0.25,\n",
    "        size=2\n",
    "    )\n",
    "    plt.title('Median Household Income Distribution by Group')\n",
    "    plt.xlabel('Group')\n",
    "    plt.ylabel('Median Household Income (USD)')\n",
    "    plt.xticks(rotation=8)\n",
    "    plt.tight_layout()\n",
    "    plt.show()\n",
    "\n",
    "    print('\\nSummary stats by group:')\n",
    "    display(\n",
    "        income_violin_df.groupby('Group')['median_household_income']\n",
    "        .describe()[['count', 'mean', '50%', 'std', 'min', 'max']]\n",
    "        .rename(columns={'50%': 'median'})\n",
    "        .round(2)\n",
    "    )"
   ]
