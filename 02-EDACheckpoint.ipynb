   "source": [
    "# 1. Identify all ZIPs belonging to your 71 stadium cities\n",
    "stadium_cities = final_stadiums['City_State_Unique'].unique()\n",
    "df_uszips['City_State_Unique'] = df_uszips['city'] + \", \" + df_uszips['state_id']\n",
    "city_zips = df_uszips[df_uszips['City_State_Unique'].isin(stadium_cities)].copy()\n",
    "city_zips['zip'] = city_zips['zip'].astype(str).str.zfill(5)\n",
    "\n",
    "# 2. Extract the treatment list for filtering\n",
    "treatment_zip_list = treatment_group['Treatment_Zip'].unique()\n",
    "\n",
    "# 3. Create control group by excluding treatment ZIPs from the city list\n",
    "control_group = city_zips[~city_zips['zip'].isin(treatment_zip_list)].copy()\n",
    "\n",
    "# 4. Clean and Rename\n",
    "control_group = control_group.rename(columns={'zip': 'Control_Zip'})\n",
    "\n",
    "print(\"Control Group Summary:\")\n",
    "print(f\"Total Stadium Cities: {len(stadium_cities)}\")\n",
    "print(f\"Total ZIPs in these cities: {len(city_zips)}\")\n",
    "print(f\"Treatment ZIPs within these cities: {len(city_zips[city_zips['zip'].isin(treatment_zip_list)])}\")\n",
    "print(f\"Control ZIPs: {len(control_group)}\")"
   ]
  },
