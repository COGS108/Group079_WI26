    "import geopandas as gpd\n",
    "import pandas as pd\n",
    "\n",
    "# vectorized geometry creation\n",
    "gdf_stadiums = gpd.GeoDataFrame(\n",
    "    df_clean_stadiums, \n",
    "    geometry=gpd.points_from_xy(df_clean_stadiums.Long, df_clean_stadiums.Lat),\n",
    "    crs=\"EPSG:4326\" \n",
    ")\n",
    "\n",
    "# Load the shapes\n",
    "gdf_zcta_shapes = gpd.read_file('zip://data/00-raw/tl_2025_us_zcta520.zip')\n",
    "\n",
    "# Project the points\n",
    "gdf_stadiums = gdf_stadiums.to_crs(gdf_zcta_shapes.crs)\n",
    "\n",
    "# Spatial Join\n",
    "stadiums_with_zips = gpd.sjoin(gdf_stadiums, gdf_zcta_shapes, how=\"left\", predicate=\"within\")\n",
    "\n",
    "# Format ZIPs for merging\n",
    "stadiums_with_zips['ZCTA5CE20'] = stadiums_with_zips['ZCTA5CE20'].astype(str)\n",
    "df_uszips['zip'] = df_uszips['zip'].astype(str).str.zfill(5)\n",
    "\n",
    "# Left Join to Kaggle reference\n",
    "final_stadiums = stadiums_with_zips.merge(\n",
    "    df_uszips[['zip', 'city', 'state_id']], \n",
    "    left_on='ZCTA5CE20', \n",
    "    right_on='zip', \n",
    "    how='left'\n",
    ")\n",
    "\n",
    "# Clean up and Rename\n",
    "final_stadiums = final_stadiums.drop(columns=['zip'])\n",
    "final_stadiums = final_stadiums.rename(columns={\n",
    "    'ZCTA5CE20': 'Zip_Code', \n",
    "    'city': 'City', \n",
    "    'state_id': 'State'\n",
    "})\n",
    "\n",
    "# Apply critical patches\n",
    "final_stadiums.loc[final_stadiums['Team'] == 'Vegas Golden Knights', ['City', 'State']] = ['Las Vegas', 'NV']\n",
    "final_stadiums.loc[final_stadiums['Team'] == 'FC Dallas', ['City', 'State']] = ['Frisco', 'TX']\n",
    "\n",
    "final_stadiums['City_State_Unique'] = final_stadiums['City'] + \", \" + final_stadiums['State']\n",
    "\n",
    "# Drop unnecessary columns\n",
    "final_stadiums = final_stadiums.drop(columns=[\n",
    "    'index_right', 'GEOID20', 'GEOIDFQ20', 'CLASSFP20', \n",
    "    'MTFCC20', 'FUNCSTAT20', 'INTPTLAT20', 'INTPTLON20'\n",
    "])\n",
    "\n",
    "print(f\"Number of Stadiums: {len(final_stadiums)}\")\n",
    "\n",
    "missing_zips = final_stadiums['Zip_Code'].isna().sum()\n",
    "missing_cities = final_stadiums['City'].isna().sum()\n",
    "print(f\"\\nMissing ZIP Codes: {missing_zips}\")\n",
    "print(f\"Missing Cities: {missing_cities}\")\n",
    "\n",
    "display(final_stadiums.head(10))"
   ]
