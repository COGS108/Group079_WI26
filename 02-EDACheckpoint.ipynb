    "### Defining the Treatment Group:\n",
    "Isolate the specific neighborhoods that are most likely to be affected by the presence of a professional sports stadium\n",
    "\n",
    "- Spatial Buffer Analysis: Create a standardized 2 mile zone around each stadium coordinate to define the boundary for potential localized economic effects\n",
    "\n",
    "- Neighborhood Identification: Determine which ZIP codes fall within these impact zones\n",
    "\n",
    "- Final Treatment Group: Create list of Treatment ZIP codes"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 28,
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Treatment Group defined with 882 unique ZIP codes.\n"
     ]
    }
   ],
   "source": [
    "import geopandas as gpd\n",
    "\n",
    "# Project to meters and create 2 mile buffer\n",
    "treatment_zones = final_stadiums.to_crs(epsg=5070)\n",
    "treatment_zones['geometry'] = treatment_zones.geometry.buffer(3218.68)\n",
    "\n",
    "# Project zones back to match the Census ZCTA coordinate system\n",
    "treatment_zones_aligned = treatment_zones.to_crs(gdf_zcta_shapes.crs)\n",
    "\n",
    "# Clean columns\n",
    "cols_to_drop = ['index_right', 'index_left']\n",
    "treatment_zones_aligned = treatment_zones_aligned.drop(columns=[c for c in cols_to_drop if c in treatment_zones_aligned.columns])\n",
    "\n",
    "# Find all Census ZCTAs that touch the 2 mile stadium boundaries\n",
    "stadium_neighborhoods = gpd.sjoin(\n",
    "    gdf_zcta_shapes, \n",
    "    treatment_zones_aligned, \n",
    "    how=\"inner\", \n",
    "    predicate=\"intersects\"\n",
    ")\n",
    "\n",
    "# Extract unique ZIPs\n",
    "unique_treatment_zips = stadium_neighborhoods['ZCTA5CE20'].unique()\n",
    "treatment_group = pd.DataFrame({'Treatment_Zip': unique_treatment_zips})\n",
    "\n",
    "# Ensure all ZIPs are 5 char strings\n",
    "treatment_group['Treatment_Zip'] = treatment_group['Treatment_Zip'].astype(str).str.zfill(5)\n",
    "\n",
    "print(f\"Treatment Group defined with {len(treatment_group)} unique ZIP codes.\")"
   ]
  },
