      "Treatment (2-Mile Radius)     882\n",
      "Name: count, dtype: int64\n"
     ]
    }
   ],
   "source": [
    "# Label the groups for the final analysis\n",
    "treatment_group['Group'] = 'Treatment (2-Mile Radius)'\n",
    "control_group['Group'] = 'Control (Rest of City)'\n",
    "\n",
    "# Standardize column names for stacking\n",
    "t_list = treatment_group.rename(columns={'Treatment_Zip': 'zip_code'})[['zip_code', 'Group']]\n",
    "c_list = control_group.rename(columns={'Control_Zip': 'zip_code'})[['zip_code', 'Group']]\n",
    "\n",
    "# Stack them into one master lookup table\n",
    "combined_groups = pd.concat([t_list, c_list], ignore_index=True)\n",
    "\n",
    "# Final safety check: ensure no duplicates if a ZIP was somehow in both lists\n",
    "combined_groups = combined_groups.drop_duplicates(subset=['zip_code'])\n",
    "\n",
    "print(f\"Master Key 'combined_groups' created with {len(combined_groups)} total ZIPs.\")\n",
    "print(combined_groups['Group'].value_counts())"
   ]
